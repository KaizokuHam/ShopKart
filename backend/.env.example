dbUrl=mongodb://127.0.0.1:27017/shopkart?replicaSet=rs0
jwt_secret=replace-with-a-long-random-secret
RAZORPAY_KEY_ID=rzp_test_replace_me
RAZORPAY_KEY_SECRET=replace-with-your-test-secret
RAZORPAY_WEBHOOK_SECRET=replace-with-a-separate-webhook-secret
PORT=8085
CLIENT_ORIGIN=http://localhost:5173,http://localhost:5174
NODE_ENV=development
# Optional: create a trusted account first, then allow its email here.
# Enables product creation and progression of that account's own paid orders.
ADMIN_EMAILS=
# Use 'none' only for HTTPS cross-site hosting; default 'lax' suits local/same-site.
COOKIE_SAME_SITE=lax
# Leave at 0 locally. Set to the exact number of trusted reverse-proxy hops when hosted.
TRUST_PROXY=0
